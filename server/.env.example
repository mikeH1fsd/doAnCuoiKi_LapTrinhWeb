PORT=5000
CLIENT_URL=http://localhost:5173
JWT_SECRET=your_jwt_secret_key
JWT_EXPIRES_IN=7d

# PostgreSQL Connection (chọn 1 trong 2 cách)
# Cách 1 — PostgreSQL cài trên máy (điền giống nhau cho cả 2 dòng):
# DATABASE_URL="postgresql://postgres:123456@localhost:5432/ptit_blog"
# DIRECT_URL="postgresql://postgres:123456@localhost:5432/ptit_blog"
#
# Cách 2 — Supabase của riêng bạn:
DATABASE_URL="postgresql://user:password@host:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://user:password@host:5432/postgres"

# Supabase Storage (tùy chọn — nếu để trống thì ảnh tải lên sẽ tự lưu vào server/uploads/ trên máy)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=blog-images
